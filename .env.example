# Chiave API di OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Modello AI da usare (default: GLM 5.3 Flash)
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# Percorso del browser per la generazione PDF (opzionale: viene trovato in automatico)
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Porta del server (default 3000)
PORT=3000

# Postgres: se impostata, archivio/impostazioni/contatori stanno su DB (produzione).
# Se vuota, si usano i file JSON in data/ (sviluppo locale).
# DATABASE_URL=postgres://postgres:password@host:5432/postgres
